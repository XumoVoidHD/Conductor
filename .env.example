# Copy to .env and fill in your values.
# API settings live in api/.env (see api/.env.example).

# --- Bybit (default broker for testing) ---
# testnet keys: https://testnet.bybit.com
BYBIT_ENVIRONMENT=testnet
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_PRODUCT_TYPE=linear
BYBIT_SYMBOL=BTCUSDT
BYBIT_INSTRUMENT_ID=BTCUSDT-LINEAR.BYBIT

# mainnet (when ready)
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# --- Interactive Brokers (later — needs TWS/Gateway) ---
# Paper TWS: port 7497 | Paper IB Gateway: port 4002
TWS_ACCOUNT=DU1234567
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=10

# Local socket for control.py → worker.py
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8765

# Conductor Node (Redis command queue)
REDIS_URL=redis://127.0.0.1:6379/0
CONDUCTOR_COMMANDS_KEY=conductor:commands
CONDUCTOR_EVENTS_KEY=conductor:events
CONDUCTOR_NODES_DIR=data/nodes
CONDUCTOR_CONTROL_PORT_BASE=9000

# subprocess (local dev) | docker (spawn sibling containers; used in docker-compose)
CONDUCTOR_NODE_RUNTIME=subprocess
TRADING_NODE_IMAGE=conductor-trading-node:latest
DOCKER_NETWORK=conductor-net
DOCKER_NODES_VOLUME=
TRADING_NODE_CONTROL_PORT=9000
DOCKER_PUBLISH_CONTROL_PORT=false

# Deploy broker default for scripts/send_conductor_command.py
BROKER_ADAPTER=bybit

# When trading nodes run in Docker with IBKR later:
# IB_HOST=host.docker.internal
