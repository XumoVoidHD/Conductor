meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    
    "username": "Asphalt",
    "password": "vedansh"
  }
  // {
  //   "username": "vedansh",
  //   "password": "Password@123"
  // }
}

script:post-response {
  if (res.status === 200 && res.body.access_token) {
    bru.setEnvVar("accessToken", res.body.access_token);
  }
}

docs {
  Returns JWT `access_token`.
  
  On success, the post-response script saves it to the active environment
  as `accessToken`. All other requests use `Authorization: Bearer {{accessToken}}`.
  
  Run Login once per session (or when the token expires). Select environment **Local**.
}
​