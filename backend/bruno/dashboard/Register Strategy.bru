meta {
  name: Register Strategy
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/dashboard/strategies/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "filename": "running_ping.py"
  }
}

docs {
  Register a strategy artifact.

  **Local (shorthand):**
  `{ "filename": "running_ping.py" }`
  → source_url=`local://strategies`, source_path=`running_ping.py`
  → source_uri=`local://strategies/running_ping.py`

  **Explicit local / S3 / GCS:**
  ```json
  { "source_url": "s3://my-bucket", "source_path": "users/alice/ema_cross.py" }
  { "source_url": "gs://my-bucket", "source_path": "vault/foo.py" }
  { "source_url": "local://strategies", "source_path": "hello_bars.py" }
  ```

  ADMIN → SYSTEM / global. USER → owned by username.
  Cloud downloads use AWS/GCP default credentials from the environment.
}
